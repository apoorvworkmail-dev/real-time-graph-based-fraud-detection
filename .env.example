# Neo4j Database Connection
# Use bolt://localhost:7687 for local development, or bolt://neo4j:7687 inside Docker
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# FastAPI Application Settings
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Phase 10 — JWT Authentication & Security Configuration
# CRITICAL: In production, generate a high-entropy secret (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long-1234567890
JWT_ALGORITHM=HS256
JWT_ISSUER=fraudgraph-api
JWT_AUDIENCE=fraudgraph-client
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Initial Administrator Bootstrap (set on first boot to initialize root admin account)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@FraudGraph2026!
INITIAL_ADMIN_EMAIL=admin@fraudgraph.local
ALLOW_PUBLIC_READ_IN_DEV=false

# Frontend Configuration (Vite)
# NOTE: Vite variables are exposed to the browser. NEVER put JWT secrets here!
VITE_API_BASE_URL=http://localhost:8000

